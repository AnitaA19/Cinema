# CinemaGo ASP.NET API. The browser talks to this Next.js app, which forwards /cinema-api to this URL.
CINEMA_API_URL=https://localhost:7086

# Optional: live (always proxy) or demo (sample data that follows the same API).
# Leave unset to use the API when it answers, and the sample programme when it does not.
# CINEMA_API_MODE=live
